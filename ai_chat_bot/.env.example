# Which LLM provider to use: "groq" (free) or "anthropic" (paid, Claude)
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=openai/gpt-oss-120b

# Only needed if you switch LLM_PROVIDER to "anthropic" later
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# Port this service runs on (separate from your Node backend's 5000)
CHATBOT_PORT=8000

# Your existing Node/Express ecommerce backend
NODE_BACKEND_URL=http://localhost:5000/api
