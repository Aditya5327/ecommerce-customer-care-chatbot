# MongoDB Atlas connection string
# Get this from Atlas dashboard -> Connect -> Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecommerce-electronics

# Server port
PORT=5000

# JWT secret for auth (Phase 2) - use a long random string
JWT_SECRET=change_this_to_a_random_secret_string

# URL of the Flask chatbot service (Phase 4)
CHATBOT_SERVICE_URL=http://localhost:8000

# Razorpay keys - get from Razorpay Dashboard > Settings > API Keys
# Use TEST mode keys while developing (they start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
